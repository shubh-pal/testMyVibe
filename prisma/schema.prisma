// TestMyVibe data model (MCP-based static audit)
//
// A Project represents a codebase. It exposes an MCP endpoint (auth'd by
// mcpToken) that the user's own MCP-compatible AI coding session connects
// to. That AI session reads the real source code, discovers user flows,
// and reports back:
//   - Flows (a named journey, e.g. "Login") made of plain-English Steps
//   - Runs (one audit pass over a Flow)
//   - Issues found during that audit, each with a ready-to-paste fixPrompt
//
// Nothing here executes code or drives a browser — all reasoning happens in
// the connecting AI session; this app is just the durable store + dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  // Retained only for backwards-compatible reads of projects created before
  // MCP-first onboarding. New projects never collect or expose these values.
  repoPath  String?
  repoUrl   String?
  autoApproveIssues Boolean @default(false)
  autoCloseIssues Boolean @default(false)
  mcpToken  String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId   String?
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id])
  flows         Flow[]
  graph         GraphState?
  graphNodes    GraphNode[]
  graphEdges    GraphEdge[]
  graphJourneys GraphJourney[]
  mcpEvents     McpEvent[]
}

model Flow {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  source      String   @default("manual") // "manual" | "ai-discovered"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  graphJourney GraphJourney?
  steps        Step[]
  runs         Run[]
}

// A plain-English step in a user journey, e.g.:
//   order: 0, description: "User visits the home page"
//   order: 1, description: "User clicks the Login button/link"
//   order: 2, expectedOutcome: "Redirected to /login"
// The connecting AI verifies each step against the actual source (routes,
// components, links) rather than executing anything.
model Step {
  id              String  @id @default(cuid())
  flowId          String
  flow            Flow    @relation(fields: [flowId], references: [id], onDelete: Cascade)
  order           Int
  description     String
  expectedOutcome String?
}

model Run {
  id         String    @id @default(cuid())
  flowId     String
  flow       Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  status     String // running | passed | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    String? // JSON-encoded summary counts, optionally free-text notes from the AI

  graphRevision String?
  evidenceType  String       @default("source")
  stepResults   StepResult[]
  issues        Issue[]
}

model StepResult {
  id          String  @id @default(cuid())
  runId       String
  run         Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  order       Int
  description String
  status      String // verified | missing | partial
  notes       String? // what the AI found in the code (file references, reasoning)
}

// A concrete audit finding: something missing, broken, or a gap in the
// codebase, discovered by reading the source.
//
// Lifecycle: pending (just reported) -> approved | rejected (human decides on
// the kanban board) -> in_progress (an AI claimed it via claim_next_issue) ->
// in_review (AI submitted a fix via submit_issue_resolution) -> done (human
// confirms on the board). A rejected fix in review can be sent back to
// approved to try again.
model Issue {
  id              String    @id @default(cuid())
  runId           String
  run             Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  projectId       String? // denormalized from run.flow.projectId for fast board queries
  severity        String // critical | high | medium | low
  category        String // missing-navigation | broken-link | validation | error-handling | auth | api-mismatch | accessibility | other
  title           String
  description     String
  fixPrompt       String // ready-to-paste prompt for a coding agent
  filePath        String?
  lineStart       Int?
  stepOrder       Int?
  status          String    @default("pending") // pending | approved | rejected | in_progress | in_review | done
  pickedAt        DateTime?
  resolutionNotes String? // what the AI changed, reported via submit_issue_resolution
  reviewNotes     String? // human notes when reviewing/closing
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  projects  Project[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  sessions     Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model GraphState {
  projectId           String    @id
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version             Int       @default(0)
  revision            String    @default("")
  revisionCommittedAt DateTime?
  lastAuditedRevision String?
  lastAuditedCommitAt DateTime?
  lastAuditedAt       DateTime?
  frontier            String    @default("[]")
  discoveryStatus     String    @default("pending")
  leaseRunId          String?
  leaseUntil          DateTime?
  updatedAt           DateTime  @updatedAt
}

model GraphNode {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String
  label      String
  kind       String
  group      String
  sourceRefs String
  revision   String

  @@unique([projectId, key])
  @@index([projectId, group])
}

model GraphEdge {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String
  fromKey    String
  toKey      String
  label      String
  sourceRefs String
  revision   String

  @@unique([projectId, key])
}

// One row per MCP tool call ("tools/call" JSON-RPC requests only), logged
// centrally in the /api/mcp route. Purely for usage analytics on the
// super-admin dashboard — never read by the MCP server itself.
model McpEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tool      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([tool, createdAt])
}

model GraphJourney {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  flowId    String    @unique
  flow      Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  edgeKeys  String
  status    String    @default("pending")
  revision  String
  auditedAt DateTime?

  @@unique([projectId, key])
  @@index([projectId, status])
}
