# Postgres connection Prisma uses at runtime. If it's behind a transaction-mode
# pooler (e.g. Supabase's Supavisor on port 6543, "?pgbouncer=true"), also set
# DIRECT_URL to a non-pooled (or session-mode, port 5432) connection —
# `prisma migrate` needs prepared-statement support transaction pooling lacks.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Comma-separated emails allowed to view /admin (usage analytics across every
# workspace: signups, MCP tool-call activity, audit/issue counts). Anyone
# signed in with one of these emails sees it; no DB flag, no extra role UI.
SUPER_ADMIN_EMAILS=""

# To operate the same projects locally as the deployed app, use the same
# DATABASE_URL and DIRECT_URL values as the live deployment, then sign in with
# an existing live account. Sessions, workspaces, projects, issues, and MCP
# planning data are all stored in this database. Never commit a real .env file.
